{
  "name": "akilli-ulasim-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Şehir akıllı ulaşım portalı için alternatif arayüz",
  "scripts": {
    "dev": "vite",
    "dev:backend": "npm run dev --prefix backend",
    "dev:all": "npm run dev & npm run dev:backend -- --remote",
    "build": "tsc && vite build",
    "build:backend": "npm run build --prefix backend",
    "planner:fetch": "tsx backend/scripts/planner-ci.ts fetch-normalize",
    "planner:signature": "tsx backend/scripts/planner-ci.ts compute-source-signature",
    "planner:compile": "tsx backend/scripts/planner-ci.ts compile-dataset",
    "planner:validate": "tsx backend/scripts/planner-ci.ts validate-dataset",
    "planner:promote": "tsx backend/scripts/planner-ci.ts promote-manifest",
    "preview": "vite preview",
    "pages:dev": "npx wrangler pages dev dist --compatibility-date=2025-10-31",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --project frontend --project node",
    "test:frontend": "vitest run --project frontend",
    "test:node": "vitest run --project node",
    "test:backend": "vitest run --project backend",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit && tsc --noEmit -p backend",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "@capacitor/android": "8.0.0",
    "@capacitor/app": "8.0.0",
    "@capacitor/browser": "8.0.0",
    "@capacitor/cli": "8.3.1",
    "@capacitor/clipboard": "8.0.0",
    "@capacitor/core": "8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/haptics": "8.0.0",
    "@capacitor/keyboard": "8.0.0",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/network": "8.0.0",
    "@capacitor/preferences": "8.0.0",
