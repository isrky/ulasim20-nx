{
  "name": "ulasim20-tools",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/generators",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": { "executor": "nx:run-commands", "options": { "command": "tsc --build tools" } },
    "type-check": { "executor": "nx:run-commands", "options": { "command": "tsc --build tools" } },
    "lint": { "executor": "nx:run-commands", "options": {
        "commands": [
          "biome lint tools",
          "eslint --config libs/config/eslint/eslint.config.mjs --no-warn-ignored 'tools/**/*.{ts,tsx,js,jsx}'"
        ],
        "parallel": false
      } }
  }
}
