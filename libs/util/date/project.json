{
  "name": "util-date",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/util/date/src",
  "projectType": "library",
  "tags": ["type:util"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p libs/util/date" }
