    "type-check": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p libs/util/date" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --project=node libs/util/date" }
    },
    "lint": { "executor": "nx:run-commands", "options": { "command": "biome lint libs/util/date" } }
  }
}
