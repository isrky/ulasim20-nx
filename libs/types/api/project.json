{
  "name": "types-api",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/types/api/src",
  "projectType": "library",
  "tags": ["type:types", "scope:shared"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p libs/types/api" }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p libs/types/api" }
    },
    "lint": { "executor": "nx:run-commands", "options": {
        "commands": [
          "biome lint libs/types/api",
          "eslint --config libs/config/eslint/eslint.config.mjs --no-warn-ignored 'libs/types/api/**/*.{ts,tsx,js,jsx}'"
        ],
        "parallel": false
      } }
  }
}
