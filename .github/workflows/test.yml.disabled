name: Tests

on:
  pull_request:
  push:
    branches: [main]

concurrency:
  group: tests-${{ github.ref }}
  cancel-in-progress: true

jobs:
  typecheck:
    name: Typecheck
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: 'npm'

      - name: Install root dependencies
        run: npm ci

      - name: Install backend dependencies
        run: npm ci --prefix backend

      - name: Typecheck (frontend + backend)
        run: npm run typecheck

  unit:
    name: Unit & integration tests
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: 'npm'

      - name: Install root dependencies
        run: npm ci

      - name: Install backend dependencies
        run: npm ci --prefix backend

      - name: Run Vitest (frontend + node) with coverage
        run: npm run test:coverage
        env:
          CI: 'true'

      - name: Run Vitest (backend / Workers pool)
        run: npm run test:backend
        env:
          CI: 'true'

      - name: Upload coverage artifact
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: coverage
          path: coverage/
          retention-days: 14

      - name: Coverage summary (report-only)
        if: always()
        run: |
          if [ -f coverage/coverage-summary.json ]; then
            node -e "const s=require('./coverage/coverage-summary.json').total;const fmt=k=>s[k]?s[k].pct+'%':'n/a';console.log('| Metric | Coverage |\n|---|---|\n| Lines | '+fmt('lines')+' |\n| Statements | '+fmt('statements')+' |\n| Functions | '+fmt('functions')+' |\n| Branches | '+fmt('branches')+' |')" >> "$GITHUB_STEP_SUMMARY"
          else
            echo 'No coverage summary produced.' >> "$GITHUB_STEP_SUMMARY"
          fi

  e2e:
    name: E2E (Playwright)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: 'npm'

      - name: Install root dependencies
        run: npm ci

      - name: Install Playwright browsers
        run: npx playwright install --with-deps chromium

      - name: Build frontend for preview
        run: npm run build
        env:
          REMOTE: 'true'

      - name: Run Playwright tests
        run: npm run test:e2e
        env:
          CI: 'true'
          REMOTE: 'true'

      - name: Upload Playwright report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: playwright-report
          path: |
            playwright-report/
            test-results/
          retention-days: 14
